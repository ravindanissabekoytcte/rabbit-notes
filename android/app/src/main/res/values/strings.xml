    <string name="charm_clover_name">Clover of Second Chances</string>
    <string name="charm_clover_lore">Pressed flat in an old seed packet, it still smells of rain.</string>
    <string name="charm_bell_name">Bell of Morning Luck</string>
    <string name="charm_bell_lore">It rings once at sunrise, and only the rabbits hear it.</string>
    <string name="charm_acorn_name">Acorn of Quiet Steps</string>
    <string name="charm_acorn_lore">Carried in a cheek pouch, it muffles the loudest hop.</string>
    <string name="charm_dewdrop_name">Dewdrop of Clear Sight</string>
    <string name="charm_dewdrop_lore">Hold it to the light and the leaves turn almost transparent.</string>
    <string name="charm_ribbon_name">Ribbon of Warm Weather</string>
    <string name="charm_ribbon_lore">Tied to a fence post, it has never once pointed at a storm.</string>
    <string name="charm_lantern_name">Lantern of Late Gardens</string>
    <string name="charm_lantern_lore">A thimble of fireflies that keeps the last row visible.</string>
    <string name="charm_feather_name">Feather of Soft Landings</string>
    <string name="charm_feather_lore">Dropped by a sparrow who owed the garden a favour.</string>
    <string name="charm_pebble_name">Pebble of Patient Paths</string>
    <string name="charm_pebble_lore">Worn smooth by rabbits who stopped to think first.</string>
    <string name="charm_thimble_name">Thimble of Mended Rows</string>
    <string name="charm_thimble_lore">Every torn leaf it touches knits itself back together.</string>
    <string name="charm_marigold_name">Marigold of Bold Choices</string>
    <string name="charm_marigold_lore">It opens wide on the mornings that reward courage.</string>
    <string name="charm_keyring_name">Keyring of Hidden Gates</string>
    <string name="charm_keyring_lore">Three small keys, and nobody remembers the third gate.</string>
    <string name="charm_moonseed_name">Moonseed of Long Nights</string>
    <string name="charm_moonseed_lore">Planted at dusk, it sprouts only while the garden sleeps.</string>

